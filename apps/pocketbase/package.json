{
	"name": "pocketbase-app",
	"type": "module",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"dev": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; ./pocketbase serve --http=0.0.0.0:8090 --encryptionEnv=PB_ENCRYPTION_KEY --dir=${PB_DATA_DIR:-./pb_data} --hooksWatch=false",
		"start": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; ./pocketbase serve --http=0.0.0.0:8090 --encryptionEnv=PB_ENCRYPTION_KEY --dir=/data --migrationsDir=./pb_migrations --hooksDir=./pb_hooks --hooksWatch=false",
		"migrations:up": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; ./pocketbase horizons migrations:up --encryptionEnv=PB_ENCRYPTION_KEY --dir=./pb_data --migrationsDir=./pb_migrations --hooksDir=./pb_hooks --hooksWatch=false",
		"migrations:revert": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; ./pocketbase horizons migrations:revert --encryptionEnv=PB_ENCRYPTION_KEY --dir=./pb_data --migrationsDir=./pb_migrations --hooksDir=./pb_hooks --hooksWatch=false",
		"migrations:snapshot": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; mkdir -p ./pb_snapshots && echo 'y' | ./pocketbase migrate collections --encryptionEnv=PB_ENCRYPTION_KEY --dir=./pb_data --migrationsDir=./pb_snapshots",
		"update": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; ./pocketbase update --encryptionEnv=PB_ENCRYPTION_KEY --backup=0"
	}
}
